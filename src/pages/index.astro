---
const ages = [
  { label: "Ages 2-3", note: "First tracing and matching" },
  { label: "Ages 3-4", note: "Letters, shapes, counting" },
  { label: "Ages 4-5", note: "Sounds, numbers, patterns" },
  { label: "Ages 5-7", note: "Early reading and math" },
];
const samples = [
  { title: "Alphabet Tracing A-Z", age: "Ages 3-5" },
  { title: "Number Tracing 1-10", age: "Ages 3-5" },
  { title: "Which One Is Different?", age: "Ages 2-4" },
  { title: "Beginning Sounds", age: "Ages 4-6" },
];
const bird = `<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Little blue bird mascot"><path d="M18 70 L2 62 L8 80 Z" fill="#4F6F8C"/><ellipse cx="62" cy="72" rx="38" ry="32" fill="#6E8FB0"/><ellipse cx="68" cy="82" rx="26" ry="20" fill="#FFF6E0"/><circle cx="78" cy="42" r="24" fill="#6E8FB0"/><ellipse cx="82" cy="52" rx="14" ry="10" fill="#FFF6E0"/><circle cx="86" cy="38" r="3.5" fill="#2F3437"/><circle cx="87" cy="37" r="1" fill="#fff"/><circle cx="94" cy="50" r="5" fill="#F1C9AE"/><path d="M98 40 L112 45 L98 50 Z" fill="#E8B07A"/><path d="M40 66 Q58 56 70 78 Q52 88 40 66 Z" fill="#4F6F8C"/><path d="M52 100 v10 M66 100 v10" stroke="#C9996B" stroke-width="3" stroke-linecap="round"/></svg>`;
const books = `<svg viewBox="0 0 160 70" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="10" y="46" width="140" height="22" rx="4" fill="#B5C4A6"/><rect x="20" y="26" width="120" height="22" rx="4" fill="#F1C9AE"/><rect x="30" y="6" width="100" height="22" rx="4" fill="#4F6F8C"/></svg>`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light only" />
  <title>Little Learner Days | Free Printable Worksheets for Ages 2-7</title>
  <meta name="description" content="Free, print-ready worksheets for ages 2-7. No sign-up. Ready in under a minute." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Lora:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root { --bg:#FFFBEA; --card:#FFFEF8; --blue:#4F6F8C; --sage:#B5C4A6; --peach:#F1C9AE; --text:#2F3437; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--text); font-family: Lora, Georgia, serif; line-height:1.6; }
    .wrap { max-width:1040px; margin:0 auto; padding:0 20px; }
    header { padding:14px 0; border-bottom:1px solid #EFE6C8; }
    header .wrap { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; }
    .logo { display:flex; align-items:center; gap:10px; color:var(--blue); font-family:Fraunces, Georgia, serif; font-size:1.5rem; font-weight:700; text-decoration:none; }
    .logo .mini { width:42px; height:42px; display:block; }
    .logo .mini svg { width:100%; height:100%; }
    nav a { color:var(--text); text-decoration:none; margin-left:18px; font-family: system-ui, sans-serif; font-size:.95rem; }
    h1, h2 { font-family:Fraunces, Georgia, serif; color:var(--blue); }
    h1 { font-size:clamp(2rem,5vw,3.2rem); line-height:1.15; margin:0 0 14px; }
    h2 { margin:0 0 16px; }
    .hero { padding:48px 0 30px; display:flex; align-items:center; justify-content:space-between; gap:30px; flex-wrap:wrap; }
    .hero-text { flex:1 1 380px; }
    .hero p { font-size:1.2rem; max-width:620px; }
    .hero-art { flex:0 1 230px; margin:0 auto; text-align:center; }
    .hero-art .bird { width:150px; margin:0 auto -14px; position:relative; z-index:1; }
    .hero-art .bird svg { width:100%; display:block; transform:scaleX(-1); }
    .hero-art .books { width:210px; margin:0 auto; }
    .hero-art .books svg { width:100%; display:block; }
    .btn { display:inline-block; background:var(--blue); color:#fff; padding:14px 26px; border-radius:10px; text-decoration:none; font-family:system-ui,sans-serif; font-weight:600; }
    .trust { display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; font-family:system-ui,sans-serif; font-size:.9rem; }
    .trust span { background:var(--card); border:1px solid #EFE6C8; padding:6px 12px; border-radius:20px; }
    section { padding:34px 0; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; }
    .card { background:var(--card); border:1px solid #EFE6C8; border-radius:14px; padding:20px; text-decoration:none; color:var(--text); }
    .card strong { font-family:Fraunces, Georgia, serif; color:var(--blue); font-size:1.15rem; display:block; }
    .age { border-top:6px solid var(--sage); }
    .ws { border-top:6px solid var(--peach); }
    .paper { height:130px; background:#fff; border:1px dashed #cfc7a8; border-radius:6px; margin-bottom:12px; display:flex; align-items:center; justify-content:center; color:#9a9374; font-family:system-ui,sans-serif; font-size:.85rem; }
    .tag { font-family:system-ui,sans-serif; font-size:.8rem; color:#7a7455; }
    .steps { counter-reset:s; }
    .steps .card { position:relative; padding-left:64px; }
    .steps .card::before { counter-increment:s; content:counter(s); position:absolute; left:20px; top:18px; width:30px; height:30px; border-radius:50%; background:var(--peach); color:var(--blue); font-weight:bold; text-align:center; line-height:30px; }
    footer { border-top:1px solid #EFE6C8; padding:26px 0; font-family:system-ui,sans-serif; font-size:.9rem; color:#6b6850; }
  </style>
  <link rel="stylesheet" href="/bird.css" />
</head>
<body>
  <header>
    <div class="wrap">
      <a class="logo" href="/"><span class="mini" set:html={bird} />Little Learner Days</a>
      <nav>
        <a href="/printables">Free Printables</a>
        <a href="/learning-activities">Activities</a>
        <a href="/parent-teacher-corner">Parents &amp; Teachers</a>
        <a href="/about">About</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <div class="hero">
      <div class="hero-text">
        <h1>Free printables, ready in under a minute.</h1>
        <p>Simple, print-ready worksheets for ages 2 to 7. Made for busy parents, teachers, and caregivers. Little moments. Big discoveries.</p>
        <a class="btn" href="/printables">Browse free printables</a>
        <div class="trust">
          <span>✓ No sign-up</span>
          <span>✓ Prints on US Letter or A4</span>
          <span>✓ Ink-friendly black and white</span>
          <span>✓ Sorted by age</span>
        </div>
      </div>
      <div class="hero-art">
        <div class="bird" set:html={bird} />
        <div class="books" set:html={books} />
      </div>
    </div>

    <section>
      <h2>Start with your child's age</h2>
      <div class="grid">
        {ages.map((a) => (
          <a class="card age" href="/printables">
            <strong>{a.label}</strong>{a.note}
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2>Popular worksheets</h2>
      <div class="grid">
        {samples.map((s) => (
          <a class="card ws" href="/printables">
            <div class="paper">Worksheet preview</div>
            <strong>{s.title}</strong>
            <span class="tag">{s.age} · Example listing</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2>From search to printer in 3 steps</h2>
      <div class="grid steps">
        <div class="card"><strong>Pick an age</strong>Find activities made for your child's stage.</div>
        <div class="card"><strong>Preview it</strong>See exactly what you'll print.</div>
        <div class="card"><strong>Download and print</strong>One tap. No account needed.</div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">© Little Learner Days · Little moments. Big discoveries.</div>
  </footer>
</body>
</html>
